# vault-graph configuration — copy to .env and adjust
#   cp .env.example .env

# Absolute or ~-relative path to your Obsidian vault (the folder containing .obsidian).
VAULT_GRAPH_VAULT=~/MyVault

# Server bind address. 0.0.0.0 = reachable from your LAN (phone/tablet), 127.0.0.1 = local only.
VAULT_GRAPH_HOST=0.0.0.0

# Port the graph server listens on.
VAULT_GRAPH_PORT=8777